# คัดลอกเป็น .env สำหรับพัฒนาบนเครื่อง (npm run dev)
#
# ⚠️ ตัวแปรที่ขึ้นต้นด้วย VITE_ จะถูกฝังลงไฟล์ JS ที่ผู้ใช้ดาวน์โหลดได้
#    → ห้ามใส่ token/ความลับในตัวแปร VITE_ เด็ดขาด
#    ความลับ (CAPI token, Shopify admin token, LINE OA token) ให้ตั้งเป็น
#    secret ของ Cloudflare Worker / Pages Functions แล้วอ่านผ่าน env.* เท่านั้น
#
# บน production ให้ตั้งค่าเหล่านี้ที่
# Cloudflare Pages → Settings → Environment variables (Production) แล้ว deploy ใหม่
# (ค่าถูก inline ตอน build ทุกครั้ง — แก้แล้วต้อง rebuild)

# ── พิกเซลโฆษณา: ปล่อยว่างได้ = ระบบจะไม่โหลด SDK ของแพลตฟอร์มนั้นเลย ──
VITE_META_PIXEL_ID=
VITE_GA4_MEASUREMENT_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_LINE_TAG_ID=

# ── CRM / affiliate worker (มี fallback ในโค้ดแล้ว: src/lib/crm.js) ──
VITE_CRM_API_URL=https://bruno-crm-aff.pkkokola.workers.dev

# ── Shopify: ต่อร้านค้าจริงเพื่อให้หน้าร้านแสดงสินค้าจริง ──────────────
# ถ้าไม่ตั้งค่าเหล่านี้ หน้าร้านจะใช้แคตตาล็อกตัวอย่างใน src/data/products.js
# (ไม่พัง — เป็น fallback ที่ตั้งใจไว้) และ /api/products จะตอบ 503
#
# ต้องมี SHOPIFY_STORE_URL เสมอ (ใส่ xxx.myshopify.com หรือ https://xxx.myshopify.com ก็ได้)
SHOPIFY_STORE_URL=
#
# เลือก token อย่างใดอย่างหนึ่ง:
#
# (1) Admin API access token — ข้อมูลครบสุด (สินค้า/สต็อก/ออเดอร์ในอนาคต)
#     สร้างที่ Shopify admin → Apps → Develop apps → Create app → scope: read_products
#     ⚠️ เป็นความลับ: ห้ามขึ้นต้นด้วย VITE_ และอย่า commit
SHOPIFY_ADMIN_API_TOKEN=
#
# (2) Storefront API public access token — อ่านอย่างเดียว ปลอดภัยกว่า แต่ข้อมูลน้อยกว่า
SHOPIFY_STOREFRONT_TOKEN=

